# =============================================================================
# SpectraMeet MVP 1 - KONFIGURASI
#
# Cara pakai:
#   1. Salin file ini menjadi ".env" di folder yang sama (akar repo).
#   2. Isi nilai yang kosong di bawah.
#   3. Jalankan ulang aplikasi. Perubahan .env BARU BERLAKU setelah restart.
#
# ".env" tidak masuk git. Jangan pernah menaruh kunci asli di file ini.
# Ini SATU-SATUNYA tempat mengubah pengaturan. Tidak ada nilai di kode.
# =============================================================================


# ----- 1. UMUM  (dibaca: API dan web, dikelola Dev 1) -------------------------

# Port. Ubah hanya bila bentrok dengan aplikasi lain di laptop.
API_PORT=8000
WEB_PORT=3000

# Folder penyimpanan audio, hasil, cache model, dan database SQLite.
# Relatif terhadap akar repo, atau isi jalur lengkap (mis. D:/spectrameet-data).
DATA_DIR=data


# ----- 2. UNGGAHAN  (dibaca: API; web ikut lewat /api/config) -----------------

# Ukuran maksimum file audio dalam MB.
MAX_UPLOAD_MB=200

# Format yang diterima, dipisah koma, tanpa titik.
ALLOWED_EXTENSIONS=mp3,wav,m4a,webm,ogg,flac

# Seberapa sering halaman Proses menanyakan status, dalam milidetik.
POLL_INTERVAL_MS=1500


# ----- 3. PIPELINE  (dibaca: API untuk menjalankan pipeline) ------------------

# true  = pakai pipeline TIRUAN (data contoh, tanpa model AI). Untuk pengembangan
#         web dan API sebelum pipeline Dev 2 siap. Kunci di bawah tidak diperlukan.
# false = pakai pipeline ASLI buatan Dev 2.
USE_MOCK_PIPELINE=true

# Python milik pipeline (lingkungan terpisah dari API). Hanya dipakai bila
# USE_MOCK_PIPELINE=false.
# KOSONGKAN agar otomatis: Windows -> pipeline/.venv/Scripts/python.exe,
# Linux/macOS -> pipeline/.venv/bin/python. Isi hanya bila venv pipeline ada di tempat lain.
PIPELINE_PYTHON=

# Khusus pipeline TIRUAN (USE_MOCK_PIPELINE=true), untuk menguji tampilan:
# Lama tiap tahap dalam detik.
MOCK_STEP_SECONDS=2
# 0 = tidak gagal. Isi 1-5 untuk mensimulasikan gagal di tahap itu satu kali
# (lalu "Coba lagi" berhasil). Berguna untuk menguji tampilan Gagal.
MOCK_FAIL_AT_STEP=0


# ----- 4. LLM GRATIS GOOGLE  (dibaca: pipeline tahap 5, dikelola Dev 2) -------

LLM_PROVIDER=google

# Kunci API Gemini. Buat gratis di: https://aistudio.google.com/apikey
# Wajib bila USE_MOCK_PIPELINE=false.
LLM_API_KEY=

# Nama model Gemini yang dipakai. Isi dengan model yang tersedia di paket gratis
# saat ini (cek di https://ai.google.dev/gemini-api/docs/models).
LLM_MODEL=

# Catatan privasi: di paket gratis, Google dapat memakai data yang dikirim untuk
# meningkatkan produknya. Hanya teks transkrip yang dikirim, bukan audio.


# ----- 5. SUARA KE TEKS  (dibaca: pipeline tahap 2-4, dikelola Dev 2) ---------

# Token Hugging Face untuk model pembeda pembicara (pyannote).
# Buat di: https://huggingface.co/settings/tokens
# Lalu setujui lisensi model pyannote di halaman modelnya, bila tidak akan gagal.
# Wajib bila USE_MOCK_PIPELINE=false.
HF_TOKEN=

# Ukuran model Whisper: tiny, base, small, medium, large-v3.
# Makin besar makin akurat tapi makin lambat dan makin boros memori.
WHISPER_MODEL=small

# cpu atau cuda (cuda hanya bila laptop punya GPU NVIDIA).
DEVICE=cpu

# Ketelitian hitungan model. Kosongkan agar otomatis: int8 di cpu, float16 di cuda.
COMPUTE_TYPE=

# true  = cocokkan waktu per kata (alignment). Lebih akurat tapi mengunduh model
#         tambahan (bahasa Indonesia sekitar 1,2 GB) dan lebih lambat.
# false = lewati alignment, waktu hanya per kalimat.
ALIGN=true
